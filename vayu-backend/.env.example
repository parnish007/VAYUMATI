# Server
NODE_ENV=production
PORT=3001

# MQTT — HiveMQ Cloud free tier
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# HiveMQ free allows anonymous connections, leave blank for demo

# InfluxDB Cloud free tier
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=your_influxdb_api_token_here
INFLUXDB_ORG=your_influxdb_org_id_here   # numeric org ID from InfluxDB Cloud → Settings → Organisation
INFLUXDB_BUCKET=sensor-readings

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WA_FROM=whatsapp:+14155238886
# ^^ This is the Twilio sandbox number, use it for demo

# Fallback APIs (no keys required — all free, no account needed)
# NOTE: OpenAQ v2 is deprecated (410). v3 requires paid API key. Using Open-Meteo AQ instead.
SOILGRIDS_API_URL=https://rest.soilgrids.org/soilgrids/v2.0
OPENMETEO_API_URL=https://api.open-meteo.com/v1
OPENMETEO_AQ_URL=https://air-quality-api.open-meteo.com/v1

# PostgreSQL — user/auth data (Railway adds this automatically when you add the Postgres addon)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local dev: postgresql://localhost:5432/vayumitti

# Google AI (Gemini) — fallback for MATI when Anthropic quota is exhausted
# Get keys at: https://aistudio.google.com/apikey (free tier, add up to 3 for rotation)
GOOGLE_AI_API_KEY_1=
GOOGLE_AI_API_KEY_2=
GOOGLE_AI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# Auth
JWT_SECRET=generate_a_random_64_char_string_here
JWT_EXPIRY=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://vayu-mati.vercel.app

# Node health check interval (ms)
HEALTH_CHECK_INTERVAL=30000
NODE_TIMEOUT_MS=90000

# Ward configuration
DEFAULT_WARD_ID=11
DEFAULT_FIELD_ID=A1
DEFAULT_LAT=27.717
DEFAULT_LNG=85.324

# Kiln coordinates (comma-separated lat:lng pairs)
KILN_COORDS=27.672:85.430,27.681:85.405,27.688:85.386

# Demo mode (uses simulated data if sensors offline)
DEMO_MODE=false
